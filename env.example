# ─────────────────────────────────────────────────────────────────────────────
# Ceyteq General Management System — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# Where to find them: Supabase Dashboard → Project Settings → API / Database.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon public" key (safe in the browser — RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" key — SERVER ONLY. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Pooled Postgres connection string (Supabase → Database → Connection pooling).
# Used by future server-side tooling/migrations; keep sslmode=require.
DATABASE_URL=

# Public URL of this app (no trailing slash). Local: http://localhost:3000
# Production: your Vercel domain, e.g. https://app.ceyteq.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First Super Master Admin account, created by `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Ceyteq Administrator

# Optional: salt for hashing IPs in audit_logs. If unset, the service-role
# key is used as the HMAC secret. Any long random string works.
AUDIT_IP_HASH_SECRET=
